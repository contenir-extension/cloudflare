{
    "name": "contenir-extension/cloudflare",
    "description": "The Cloudflare add-on for Contenir CMS: purges Cloudflare's cache when content and files change, with an API token, a connection test, Purge everything and Purge URLs, and a log of every purge.",
    "type": "contenir-extension",
    "license": "BSD-3-Clause",
    "keywords": [
        "contenir",
        "contenir-extension",
        "cloudflare",
        "cdn",
        "cache",
        "purge"
    ],
    "support": {
        "issues": "https://github.com/contenir-extension/cloudflare/issues",
        "source": "https://github.com/contenir-extension/cloudflare"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/contenir/contenir-cdn"
        },
        {
            "type": "vcs",
            "url": "https://github.com/contenir/contenir-extension-api"
        }
    ],
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "contenir/cdn": "dev-feat/cdn-library as 0.1.0",
        "contenir/extension-api": "dev-feat/provide as 0.6.0",
        "guzzlehttp/guzzle": "^7.9",
        "psr/http-client": "^1.0.3",
        "psr/http-factory": "^1.1",
        "psr/log": "^3.0.2"
    },
    "require-dev": {
        "contenir/contenir-qa-tools": "0.1.x-dev",
        "infection/infection": "^0.34.1",
        "nyholm/psr7": "^1.8.2",
        "phpunit/phpunit": "^11.5.42"
    },
    "autoload": {
        "psr-4": {
            "Contenir\\Extension\\Cloudflare\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contenir\\Extension\\Cloudflare\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "boundary": "extension-boundary",
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test",
            "@test-integration",
            "@mutation-test"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint",
            "mago guard"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "static-analysis": "mago analyze",
        "test": "phpunit --colors=always --testsuite unit",
        "test-integration": "phpunit --colors=always --testsuite integration",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "mutation-test": "infection"
    },
    "extra": {
        "contenir": {
            "handle": "cloudflare",
            "extension": "Contenir\\Extension\\Cloudflare\\CloudflareExtension"
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.99"
        },
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
